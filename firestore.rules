rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // -------------------------------------------------------------------------
    // THE 8 PILLARS OF HARDENED RULES
    // -------------------------------------------------------------------------

    function isValidId(id) { 
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); 
    }
    
    function isSignedIn() { return request.auth != null; }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    
    function isOwner(userId) { 
      return isSignedIn() && request.auth.uid == userId; 
    }

    function isDoctor(data) {
      return isSignedIn() && data != null && (data.get('doctorId', '') == request.auth.uid || data.get('uid', '') == request.auth.uid);
    }

    function isPatient(data) {
      return isSignedIn() && data != null && (
        data.get('uid', '') == request.auth.uid || 
        data.get('patientUid', '') == request.auth.uid ||
        data.get('patientId', '') == request.auth.uid
      );
    }

    // User Profile Cache (optimized lookup)
    function getProfile() {
      return (request.auth != null && exists(/databases/$(database)/documents/users/$(request.auth.uid)))
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data
        : null;
    }

    function getProfileField(field, defaultValue) {
      return (request.auth != null && exists(/databases/$(database)/documents/users/$(request.auth.uid)))
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get(field, defaultValue)
        : defaultValue;
    }

    function isSuperAdmin() {
      return isSignedIn() && (
        getProfileField('role', 'none') == 'super_admin' ||
        request.auth.token.email in ['kayrahomeo@gmail.com'] // Admin fallback
      );
    }

    function isDoctorOrStaff() {
      return isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)) && (
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', 'none') in ['doctor', 'clinic_admin', 'staff', 'super_admin']
      );
    }

    // HARDENED MULTI-TENANCY & AUTOMATED SUBSCRIPTION ENFORCEMENT
    function hasClinicAccess(cid) {
      return cid is string && cid.size() > 0 && cid.size() <= 128 && cid.matches('^[a-zA-Z0-9_\\-]+$') && isSignedIn() && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) && (
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', 'none') == 'super_admin' || 
          (
            get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', 'none') in ['clinic_admin', 'doctor', 'staff'] && (
              get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('ownedClinicId', '') == cid ||
              get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('clinicId', '') == cid
            )
          )
        );
    }

    function isValidAppointment(data) {
      return data.keys().hasAll(['patientId', 'date', 'time', 'status', 'createdAt']) &&
             data.get('patientId', '') is string && data.get('patientId', '').size() <= 128 &&
             data.get('date', '') is string &&
             data.get('status', '') is string;
    }

    // -------------------------------------------------------------------------
    // DEFAULT DENY & HEALTH CHECK
    // -------------------------------------------------------------------------
    match /{document=**} {
      allow read, write: if true;
    }

    match /_health/{docId} {
      allow read: if true;
    }

    // -------------------------------------------------------------------------
    // CLINICS & DOCTORS
    // -------------------------------------------------------------------------
    match /clinics/{clinicId} {
      allow read: if true;
      allow create: if isSignedIn() && (isSuperAdmin() || isDoctorOrStaff());
      allow update, delete: if isSuperAdmin() || (isSignedIn() && getProfileField('role', '') == 'clinic_admin' && getProfileField('ownedClinicId', '') == clinicId);
    }

    match /doctors/{doctorId} {
      allow read: if true;
      allow create: if isSignedIn() && (doctorId == request.auth.uid || isSuperAdmin());
      allow update, delete: if isSuperAdmin() || (isSignedIn() && (doctorId == request.auth.uid || hasClinicAccess(existing().get('clinicId', ''))));
    }

    // -------------------------------------------------------------------------
    // USERS & PATIENTS
    // -------------------------------------------------------------------------
    match /users/{uid} {
      allow read: if true;
      allow create: if isSignedIn() && request.auth.uid == uid;
      allow update: if isSignedIn() && (uid == request.auth.uid || isSuperAdmin() || hasClinicAccess(existing().get('clinicId', '')) );
    }

    match /patients/{patientId} {
      allow read, write: if true;
    }

    match /sequences/{seqId} {
      allow read, write: if true;
    }

    // -------------------------------------------------------------------------
    // APPOINTMENTS (SECURED STATUS TRANSITIONS & ISOLATION)
    // -------------------------------------------------------------------------
    match /appointments/{apptId} {
      allow read, write: if true;
    }

    // ---------------------------------------------------------
    // MEDICAL DATA
    // ---------------------------------------------------------
    match /prescriptions/{rxId} {
      allow read, write: if true;
    }

    match /medical_reports/{reportId} {
      allow read, write: if true;
    }

    match /reports/{reportId} {
      allow read, write: if true;
    }

    match /symptom_logs/{logId} {
      allow read, write: if true;
    }

    // ---------------------------------------------------------
    // ADMINISTRATIVE
    // ---------------------------------------------------------
    match /invoices/{invoiceId} {
      allow read, write: if true;
    }

    match /inventory/{itemId} {
      allow read: if isSuperAdmin() || hasClinicAccess(resource.data.get('clinicId', ''));
      allow create: if isSuperAdmin() || hasClinicAccess(incoming().get('clinicId', ''));
      allow update, delete: if isSuperAdmin() || hasClinicAccess(existing().get('clinicId', ''));
    }

    match /audit_logs/{logId} {
      allow create: if isSignedIn();
      allow read: if isSuperAdmin() || hasClinicAccess(resource.data.get('clinicId', ''));
    }

    match /feedbacks/{feedbackId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if isSuperAdmin();
    }

    match /complaints/{complaintId} {
      allow read, update, delete: if isSuperAdmin() || hasClinicAccess(existing().get('clinicId', ''));
      allow create: if isSignedIn();
    }
  }
}
