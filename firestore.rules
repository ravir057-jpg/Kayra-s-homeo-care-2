rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // -------------------------------------------------------------------------
    // GLOBAL HELPERS
    // -------------------------------------------------------------------------
    function isSignedIn() { return request.auth != null; }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isOwner(userId) { return isSignedIn() && request.auth.uid == userId; }
    
    // Role checks
    function getRole(uid) {
      return exists(/databases/$(database)/documents/users/$(uid)) 
        ? get(/databases/$(database)/documents/users/$(uid)).data.get('role', 'none')
        : 'none';
    }
    function isDoctor() { 
      return isSignedIn() && (
        getRole(request.auth.uid) == 'doctor' || 
        exists(/databases/$(database)/documents/doctors/$(request.auth.uid))
      ); 
    }
    function isPatient() { 
      return isSignedIn() && getRole(request.auth.uid) == 'patient'; 
    }

    // -------------------------------------------------------------------------
    // DEFAULT DENY
    // -------------------------------------------------------------------------
    match /{document=**} {
      allow read, write: if false;
    }

    // -------------------------------------------------------------------------
    // USERS COLLECTION (Auth Profiles)
    // -------------------------------------------------------------------------
    match /users/{userId} {
      allow get: if isOwner(userId) || isDoctor();
      allow list: if isDoctor();
      allow create: if isOwner(userId);
      allow update: if isOwner(userId) && incoming().get('role', 'none') == existing().get('role', 'none');
    }

    // -------------------------------------------------------------------------
    // PATIENTS COLLECTION (Medical Records)
    // -------------------------------------------------------------------------
    match /patients/{patientId} {
      allow get: if isSignedIn() && (resource.data.get('uid', '') == request.auth.uid || isDoctor() || patientId == request.auth.uid);
      allow list: if isSignedIn() && (resource.data.get('uid', '') == request.auth.uid || isDoctor() || resource.data.get('patientId', '') == request.auth.uid);
      allow create: if isSignedIn();
      allow update: if isSignedIn() && (resource.data.get('uid', '') == request.auth.uid || isDoctor() || patientId == request.auth.uid);
    }

    // -------------------------------------------------------------------------
    // DOCTORS COLLECTION (Professional Details)
    // -------------------------------------------------------------------------
    match /doctors/{doctorId} {
      allow read: if true;
      allow write: if isOwner(doctorId) || isDoctor();
    }

    // -------------------------------------------------------------------------
    // APPOINTMENTS COLLECTION
    // -------------------------------------------------------------------------
    match /appointments/{apptId} {
      allow get: if isSignedIn() && (
        resource.data.get('patientId', '') == request.auth.uid || 
        resource.data.get('patientUid', '') == request.auth.uid || 
        resource.data.get('doctorId', '') == request.auth.uid
      );
      allow list: if isSignedIn() && (
        resource.data.get('patientId', '') == request.auth.uid || 
        resource.data.get('patientUid', '') == request.auth.uid || 
        resource.data.get('doctorId', '') == request.auth.uid
      );
      allow create: if isSignedIn();
      allow update: if isSignedIn() && (
        existing().get('patientId', '') == request.auth.uid || 
        existing().get('patientUid', '') == request.auth.uid || 
        existing().get('doctorId', '') == request.auth.uid
      );
    }

    // -------------------------------------------------------------------------
    // PRESCRIPTIONS COLLECTION
    // -------------------------------------------------------------------------
    match /prescriptions/{rxId} {
      allow get: if isSignedIn() && (
        resource.data.get('patientId', '') == request.auth.uid || 
        resource.data.get('patientUid', '') == request.auth.uid || 
        resource.data.get('doctorId', '') == request.auth.uid
      );
      allow list: if isSignedIn() && (
        resource.data.get('patientId', '') == request.auth.uid || 
        resource.data.get('patientUid', '') == request.auth.uid || 
        resource.data.get('doctorId', '') == request.auth.uid
      );
      allow create: if isDoctor();
      allow update: if isDoctor();
    }

    // -------------------------------------------------------------------------
    // INVOICES COLLECTION
    // -------------------------------------------------------------------------
    match /invoices/{invoiceId} {
      allow get: if isSignedIn() && (
        resource.data.get('patientId', '') == request.auth.uid || 
        resource.data.get('doctorId', '') == request.auth.uid
      );
      allow list: if isSignedIn() && (
        resource.data.get('patientId', '') == request.auth.uid || 
        resource.data.get('doctorId', '') == request.auth.uid
      );
      allow create: if isDoctor();
      allow update: if isDoctor();
    }

    // -------------------------------------------------------------------------
    // SYMPTOM LOGS
    // -------------------------------------------------------------------------
    match /symptom_logs/{logId} {
      allow read, list: if isSignedIn() && (
        resource.data.get('patientId', '') == request.auth.uid || 
        resource.data.get('patientUid', '') == request.auth.uid || 
        isDoctor()
      );
      allow create: if isSignedIn();
    }

    // -------------------------------------------------------------------------
    // MEDICAL REPORTS
    // -------------------------------------------------------------------------
    match /medical_reports/{reportId} {
      allow read, list: if isSignedIn() && (
        resource.data.get('patientId', '') == request.auth.uid || 
        resource.data.get('patientUid', '') == request.auth.uid || 
        isDoctor()
      );
      allow write: if isSignedIn();
    }

    // -------------------------------------------------------------------------
    // FEEDBACKS / REVIEWS COLLECTION
    // -------------------------------------------------------------------------
    match /feedbacks/{feedbackId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update, delete: if isSignedIn() && (existing().get('patientUid', '') == request.auth.uid || existing().get('patientId', '') == request.auth.uid);
    }

    // -------------------------------------------------------------------------
    // INVENTORY COLLECTION
    // -------------------------------------------------------------------------
    match /inventory/{itemId} {
      allow read: if isDoctor();
      allow write: if isDoctor();
    }

    // -------------------------------------------------------------------------
    // AUDIT LOGS
    // -------------------------------------------------------------------------
    match /audit_logs/{logId} {
      allow read: if isDoctor();
      allow create: if isSignedIn();
    }

    // -------------------------------------------------------------------------
    // COMPLAINTS
    // -------------------------------------------------------------------------
    match /complaints/{complaintId} {
      allow read: if isDoctor();
      allow create: if isSignedIn();
    }
  }
}
