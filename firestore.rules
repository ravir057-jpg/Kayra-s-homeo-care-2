rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // -------------------------------------------------------------------------
    // THE 8 PILLARS OF HARDENED RULES
    // -------------------------------------------------------------------------
    
    // Pillar 3: Path Variable Hardening & Pillar 5: String Guards
    function isValidId(id) { 
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); 
    }
    
    function isSignedIn() { return request.auth != null; }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    
    // Pillar 6: PII Isolation
    function isOwner(userId) { 
      return isSignedIn() && request.auth.uid == userId; 
    }

    // Role checks (Audit-Based)
    function isDoctor() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/doctors/$(request.auth.uid)) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', 'none') == 'doctor')
      );
    }

    // Pillar 2: Validation Blueprints (The Anti-Update-Gap)
    function isValidAppointment(data) {
      return data.keys().hasAll(['patientId', 'doctorId', 'date', 'time', 'status', 'createdAt']) &&
             data.patientId is string && data.patientId.size() <= 128 &&
             data.doctorId is string && data.doctorId.size() <= 128 &&
             data.date is string && data.date.matches('^\\d{4}-\\d{2}-\\d{2}$') &&
             data.time is string && data.time.size() <= 10 &&
             data.status in ['Scheduled', 'Confirmed', 'Completed', 'Cancelled', 'payment-pending'];
    }

    // -------------------------------------------------------------------------
    // DEFAULT DENY & HEALTH CHECK
    // -------------------------------------------------------------------------
    match /_health/{docId} {
      allow read: if true;
    }

    match /{document=**} {
      allow read, write: if false;
    }

    // -------------------------------------------------------------------------
    // PATIENTS & USERS (Medical Profiles)
    // -------------------------------------------------------------------------
    match /users/{userId} {
      allow get: if isOwner(userId) || isDoctor();
      allow list: if isDoctor();
      allow create: if isOwner(userId);
      allow update: if isOwner(userId) && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'mobileNumber', 'updatedAt']);
    }

    match /patients/{patientId} {
      allow get: if isOwner(patientId) || isDoctor() || (existing().get('uid', '') == request.auth.uid);
      allow list: if isDoctor() || (resource.data.get('uid', '') == request.auth.uid);
      allow create: if isSignedIn();
      allow update: if isDoctor() || (existing().get('uid', '') == request.auth.uid);
    }

    // -------------------------------------------------------------------------
    // APPOINTMENTS (Pillar 8: Secure List Queries)
    // -------------------------------------------------------------------------
    match /appointments/{apptId} {
      allow get: if isSignedIn() && (
        resource.data.get('patientUid', '') == request.auth.uid || 
        resource.data.get('patientId', '') == request.auth.uid ||
        resource.data.get('doctorId', '') == request.auth.uid
      );
      allow list: if isSignedIn() && (
        resource.data.get('patientUid', '') == request.auth.uid || 
        resource.data.get('patientId', '') == request.auth.uid ||
        resource.data.get('doctorId', '') == request.auth.uid
      );
      allow create: if isSignedIn() && isValidId(incoming().get('doctorId', '')) && isValidAppointment(incoming());
      allow update: if isSignedIn() && (
        (incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt', 'videoLink']) && 
         (resource.data.get('patientUid', '') == request.auth.uid || 
          resource.data.get('patientId', '') == request.auth.uid ||
          resource.data.get('doctorId', '') == request.auth.uid))
      );
      allow delete: if isDoctor();
    }

    // -------------------------------------------------------------------------
    // MEDICAL DATA (HIPAA Protected)
    // -------------------------------------------------------------------------
    match /prescriptions/{rxId} {
      allow read: if isSignedIn() && (
        resource.data.get('patientUid', '') == request.auth.uid || 
        resource.data.get('patientId', '') == request.auth.uid ||
        resource.data.get('doctorId', '') == request.auth.uid
      );
      allow create, update: if isDoctor();
    }

    match /medical_reports/{reportId} {
      allow read: if isSignedIn() && (
        resource.data.get('patientUid', '') == request.auth.uid || 
        resource.data.get('patientId', '') == request.auth.uid ||
        resource.data.get('doctorId', '') == request.auth.uid
      );
      allow create: if isSignedIn();
      allow update, delete: if isDoctor();
    }

    match /symptom_logs/{logId} {
      allow read: if isSignedIn() && (
        resource.data.get('patientUid', '') == request.auth.uid || 
        resource.data.get('patientId', '') == request.auth.uid ||
        isDoctor()
      );
      allow create: if isSignedIn();
    }

    // -------------------------------------------------------------------------
    // ADMINISTRATIVE & AUDIT
    // -------------------------------------------------------------------------
    match /invoices/{invoiceId} {
      allow read: if isSignedIn() && (
        resource.data.get('patientUid', '') == request.auth.uid ||
        resource.data.get('patientId', '') == request.auth.uid || 
        resource.data.get('doctorId', '') == request.auth.uid
      );
      allow create, update: if isDoctor();
    }

    match /doctors/{doctorId} {
      allow read: if true;
      allow write: if isOwner(doctorId) || isDoctor();
    }

    match /inventory/{itemId} {
      allow read, write: if isDoctor();
    }

    match /audit_logs/{logId} {
      allow create: if isSignedIn();
      allow read: if isDoctor();
    }

    match /feedbacks/{feedbackId} {
      allow read: if isSignedIn() && (
        resource.data.get('doctorId', '') == request.auth.uid ||
        resource.data.get('patientId', '') == request.auth.uid ||
        resource.data.get('patientUid', '') == request.auth.uid
      );
      allow create: if isSignedIn() && (
        incoming().get('patientId', '') == request.auth.uid ||
        incoming().get('patientUid', '') == request.auth.uid
      );
      allow update, delete: if isDoctor();
    }

    match /complaints/{complaintId} {
      allow read, update, delete: if isDoctor();
      allow create: if isSignedIn();
    }
  }
}
