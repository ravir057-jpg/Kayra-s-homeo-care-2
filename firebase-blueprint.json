{
  "entities": {
    "clinic": {
      "title": "Clinic Profile",
      "description": "Information about a clinic tenant",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "ownerId": { "type": "string" },
        "logoUrl": { "type": "string" },
        "tagline": { "type": "string" },
        "description": { "type": "string" },
        "address": { "type": "string" },
        "city": { "type": "string" },
        "state": { "type": "string" },
        "pincode": { "type": "string" },
        "phone": { "type": "string" },
        "email": { "type": "string" },
        "subscriptionPlan": { "type": "string", "enum": ["basic", "pro", "enterprise"] },
        "subscriptionStatus": { "type": "string", "enum": ["active", "inactive", "trial"] },
        "subscriptionExpiry": { "type": "string", "format": "date-time" },
        "settings": { "type": "object" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "name", "ownerId", "subscriptionPlan"]
    },
    "patient": {
      "title": "Patient Profile",
      "description": "Patient user details for Homeopathic care",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "clinicId": { "type": "string" },
        "khcId": { "type": "string", "description": "Unique Clinic ID (e.g. KHC-123456)" },
        "name": { "type": "string" },
        "age": { "type": "number" },
        "gender": { "type": "string", "enum": ["male", "female", "other"] },
        "mobile": { "type": "string" },
        "city": { "type": "string" },
        "area": { "type": "string" },
        "pincode": { "type": "string" },
        "medicalHistory": { "type": "array", "items": { "type": "string" } },
        "allergies": { "type": "array", "items": { "type": "string" } },
        "createdAt": { "type": "string", "format": "date-time" },
        "isActive": { "type": "boolean" }
      },
      "required": ["uid", "name", "mobile"]
    },
    "doctor": {
      "title": "Doctor Profile",
      "description": "Clinic doctor details and availability",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "clinicId": { "type": "string" },
        "name": { "type": "string" },
        "qualification": { "type": "string", "description": "e.g. BHMS" },
        "regNumber": { "type": "string" },
        "specialization": { "type": "array", "items": { "type": "string" } },
        "city": { "type": "string" },
        "area": { "type": "string" },
        "pincode": { "type": "string" },
        "address": { "type": "string" },
        "availableSlots": { "type": "object", "description": "Map of days to available time slots" },
        "fees": { "type": "number", "description": "Consultation fee set by the doctor" },
        "commissionRate": { "type": "number", "description": "Percentage taken as platform commission (e.g. 10)" },
        "rating": { "type": "number" },
        "totalPatients": { "type": "number" },
        "isVerified": { "type": "boolean" },
        "isActive": { "type": "boolean" }
      },
      "required": ["uid", "name", "qualification"]
    },
    "appointment": {
      "title": "Clinical Appointment",
      "description": "Booking between patient and doctor",
      "type": "object",
      "properties": {
        "appointmentId": { "type": "string" },
        "clinicId": { "type": "string" },
        "patientId": { "type": "string" },
        "doctorId": { "type": "string" },
        "date": { "type": "string", "format": "date" },
        "timeSlot": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "confirmed", "completed", "cancelled", "payment-pending"] },
        "type": { "type": "string", "enum": ["Physical", "Online"] },
        "fee": { "type": "number", "description": "Total fee charged" },
        "commissionAmount": { "type": "number", "description": "Commission deducted" },
        "doctorNetShare": { "type": "number", "description": "Amount payable to doctor" },
        "symptoms": { "type": "string" },
        "notes": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["patientId", "doctorId", "date", "timeSlot", "status"]
    },
    "prescription": {
      "title": "Medical Prescription",
      "description": "Medicine and dosage details",
      "type": "object",
      "properties": {
        "prescriptionId": { "type": "string" },
        "clinicId": { "type": "string" },
        "appointmentId": { "type": "string" },
        "patientId": { "type": "string" },
        "doctorId": { "type": "string" },
        "medicines": { "type": "array", "items": { "type": "string" } },
        "dosage": { "type": "array", "items": { "type": "string" } },
        "duration": { "type": "array", "items": { "type": "string" } },
        "diagnosis": { "type": "string" },
        "advice": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["appointmentId", "patientId", "doctorId", "medicines"]
    },
    "medicalReport": {
      "title": "Medical Report",
      "description": "Uploaded patient reports with AI analysis",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "clinicId": { "type": "string" },
        "patientId": { "type": "string" },
        "patientUid": { "type": "string" },
        "patientName": { "type": "string" },
        "title": { "type": "string" },
        "fileName": { "type": "string" },
        "fileType": { "type": "string" },
        "fileData": { "type": "string", "description": "Base64 encoded file data" },
        "status": { "type": "string", "enum": ["Pending Analysis", "Analyzed"] },
        "category": { "type": "string", "enum": ["Pathology", "Radiology"] },
        "doctorId": { "type": "string" },
        "summary": { "type": "string" },
        "fullAnalysis": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "analyzedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["patientId", "patientUid", "title", "fileData"]
    },
    "review": {
      "title": "Doctor Review",
      "description": "Patient feedback and rating",
      "type": "object",
      "properties": {
        "reviewId": { "type": "string" },
        "patientId": { "type": "string" },
        "doctorId": { "type": "string" },
        "rating": { "type": "number", "minimum": 1, "maximum": 5 },
        "comment": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["patientId", "doctorId", "rating"]
    },
    "invoice": {
      "title": "Patient Invoice",
      "description": "Billing records",
      "type": "object",
      "properties": {
         "id": { "type": "string" },
         "patientId": { "type": "string" },
         "doctorId": { "type": "string" },
         "appointmentId": { "type": "string" },
         "amount": { "type": "number", "description": "Total amount paid" },
         "commissionAmount": { "type": "number" },
         "doctorNetShare": { "type": "number" },
         "status": { "type": "string", "enum": ["Paid", "Pending", "Cancelled"] },
         "paymentMethod": { "type": "string" },
         "createdAt": { "type": "string", "format": "date-time" }
      }
    },
    "inventory": {
       "title": "Medicine Inventory",
       "description": "Pharmacy stock levels",
       "type": "object",
       "properties": {
          "id": { "type": "string" },
          "clinicId": { "type": "string" },
          "name": { "type": "string" },
          "category": { "type": "string" },
          "stockLevel": { "type": "number" },
          "unit": { "type": "string" },
          "price": { "type": "number" },
          "lastUpdated": { "type": "string", "format": "date-time" }
       }
    },
    "symptomLog": {
       "title": "Symptom Log",
       "description": "Real-time health updates from patient",
       "type": "object",
       "properties": {
          "patientId": { "type": "string" },
          "symptoms": { "type": "string" },
          "severity": { "type": "number" },
          "createdAt": { "type": "string", "format": "date-time" }
       }
    }
  },
  "firestore": {
    "/clinics/{clinicId}": {
      "schema": "clinic",
      "description": "Clinic tenant profiles"
    },
    "/users/{userId}": {
      "schema": "patient",
      "description": "User profiles with roles (patient/doctor)"
    },
    "/patients/{patientId}": {
      "schema": "patient",
      "description": "Detailed patient medical records"
    },
    "/doctors/{doctorId}": {
      "schema": "doctor",
      "description": "Doctor professional details"
    },
    "/appointments/{apptId}": {
      "schema": "appointment",
      "description": "Appointment bookings"
    },
    "/prescriptions/{rxId}": {
      "schema": "prescription",
      "description": "Medical prescriptions"
    },
    "/medical_reports/{reportId}": {
      "schema": "medicalReport",
      "description": "Diagnostic reports with patient ownership"
    },
    "/feedbacks/{feedbackId}": {
      "schema": "review",
      "description": "Patient feedback and reviews"
    },
    "/invoices/{invoiceId}": {
       "schema": "invoice",
       "description": "Billing and payment records"
    },
    "/inventory/{itemId}": {
       "schema": "inventory",
       "description": "Clinical stock management"
    },
    "/symptom_logs/{logId}": {
       "schema": "symptomLog",
       "description": "Patient health tracking"
    },
    "/audit_logs/{logId}": {
       "schema": "object",
       "description": "Clinical audit trail"
    },
    "/complaints/{complaintId}": {
       "schema": "object",
       "description": "Patient grievances"
    }
  }
}
